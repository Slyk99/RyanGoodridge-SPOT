function allConstraints = runMPC_postProcess(dataClass, spotFilterData, MPCdata, mpcConfig, navOpts, M)
%% Load data from Simulink logs
time        = dataClass.Time_s.Data;
Results     = MPCdata.Results;
dt          = diff(time); 
u_opt       = MPCdata.optimalInputs;   % optimal inputs 3 by N by numSteps
x_opt       = MPCdata.optimalStates;   % optimal inputs 6 by N by numSteps
xc_log      = spotFilterData.estimated_States.RED(1:6,:);   % log of all chaser positions 
xt_log      = spotFilterData.estimated_States.BLACK(1:6,:); % log of all target positions 
xo_log      = spotFilterData.estimated_States.BLUE(1:6,:);  % log of all obstacle positions
Pc_log      = spotFilterData.estimated_Cov.RED;      % log of all chaser positions 
Pt_log      = spotFilterData.estimated_Cov.BLACK;    % log of all target positions 
Po_log      = spotFilterData.estimated_Cov.BLUE;     % log of all obstacle positions
z_log       = dataClass.MPC_z.Data';
Q           = navOpts.kfChaser.Q; % Same Q for all filters 
[~, N, numSteps]   = size(u_opt);

%% Initialize the MPC
% problem dimensions
n = size(mpcConfig.A,1);
m = size(mpcConfig.B,2);

% discretize dynamics
Ad = eye(n) + mpcConfig.dt*mpcConfig.A;
Bd =          mpcConfig.dt*mpcConfig.B;

[Qf, K] = spotSMPC.Gradient.dare_iterative(Ad, Bd, mpcConfig.Q, mpcConfig.R, 10000, 0.00001);

r_hold = mpcConfig.holding_radius;
proximity = false;

%% Initialize loop
% Recompute constraints at every timestep
allConstraints = struct();
prev = 0;

allConstraints.max_states        = max_states; % maximum states
allConstraints.Smax_states       = Smax_states; % maximum states + stochastic bound
allConstraints.min_states        = min_states; % minimum states
allConstraints.Smin_states       = Smin_states;% minimum states + stochastic bound
allConstraints.target_ellipse    = target_ellipse; % ellipse point of the deterministic constraint
allConstraints.target_line       = target_line; % line tangential to the ellipse at the closest point of the ellipse to the target
allConstraints.Starget_ellipse   = Starget_ellipse; % target_ellipse with stochastic bounds added to the major and minor axis
allConstraints.Starget_line(:,:,:,k)      = Starget_line; % line with the stochastic offset
allConstraints.obstacle_ellipse(:,:,:,k)  = obstacle_ellipse; % ellipse point of the deterministic constraint
allConstraints.obstacle_line(:,:,:,k)     = obstacle_line; % line tangential to the ellipse at the closest point of the ellipse to the target
allConstraints.Sobstacle_ellipse(:,:,:,k) = Sobstacle_ellipse; % target_ellipse with stochastic bounds added to the major and minor axis
allConstraints.Sobstacle_line(:,:,:,k)    = Sobstacle_line; % line with the stochastic offset


for k = 1:numSteps
    %% Check if MPC ran at this time step 
    if prev == Results(k,1) || Results(k,1) == -1
        % mpc only runs once before -1 and is ZOH so prev just makes the
        % loop skip the zoh values
        % -1 is a flag to skip computing the (control horizen)
        prev = Results(k,1);
        continue
    end

    %% Compute values as if MPC was running
    [xTstack, PTstack] = spotSMPC.InitialConditions.propTarget(xt_log(:,k), Pt_log(:,:,k), Ad, Bd, Q, n, N);
    [xOstack, POstack] = spotSMPC.InitialConditions.propTarget(xo_log(:,k), Po_log(:,:,k), Ad, Bd, Q, n, N);

    [z0, PChaser] = spotSMPC.InitialConditions.initialGuess(z_log(:,k), xc_log(:,k), Pc_log(:,:,k), [], Ad, Bd, 0*K, Q, n, m, N, M);

    % Calculate the docking port location
    [DockingPort, DockingRadius] = spotSMPC.InitialConditions.dockingLocation(xTstack, mpcConfig.docking_Offset, N);

    % Calculate the reference trajectory
    [x_ref, u_ref] = spotSMPC.InitialConditions.genReference(z0, xTstack, DockingPort, DockingRadius, m, n, N, mpcConfig.dt, mpcConfig.Camera_Offset);

    % Update reference angle if close enough to dock
    if proximity
        x_ref = spotSMPC.InitialConditions.updateAngle(x_ref, mpcConfig.docking_Offset(3), n, N);
    end

    % Calculate Holding Radius
    [r_hold,proximity] = spotSMPC.InequalityConstrains.calcHoldingDist(r_hold, proximity, x_ref, xc_log(:,k), mpcConfig.eta, mpcConfig.zeta, mpcConfig.gamma, mpcConfig.r_hold_min);

    %% Use Modified constraint code to generate plot-able data

    [max_states, Smax_states]   = buildMaxConstraintPoints(mpcConfig.x_max, PChaser, mpcConfig.H_max, N, mpcConfig.epsilon, 100);
    [min_states, Smin_states]   = buildMaxConstraintPoints(-1*mpcConfig.x_min, PChaser, -1*mpcConfig.H_min, N, mpcConfig.epsilon, 100);
    [target_ellipse, target_line, Starget_ellipse, Starget_line]         = StochasticHoldingRadiusPoints(r_hold, ...
     z0, xTstack, PTstack, mpcConfig.BlackOffset, N, mpcConfig.epsilon, 100);
    [obstacle_ellipse, obstacle_line, Sobstacle_ellipse, Sobstacle_line] = StochasticHoldingRadiusPoints(mpcConfig.ObsHold,...
     z0, xOstack, POstack, mpcConfig.BlueOffset, N, mpcConfig.epsilon, 100);

    %% Store
    allConstraints.max_states(:,:,:,k)        = max_states; % maximum states
    allConstraints.Smax_states(:,:,:,k)       = Smax_states; % maximum states + stochastic bound
    allConstraints.min_states(:,:,:,k)        = min_states; % minimum states
    allConstraints.Smin_states(:,:,:,k)       = Smin_states;% minimum states + stochastic bound
    allConstraints.target_ellipse(:,:,:,k)    = target_ellipse; % ellipse point of the deterministic constraint 
    allConstraints.target_line(:,:,:,k)       = target_line; % line tangential to the ellipse at the closest point of the ellipse to the target
    allConstraints.Starget_ellipse(:,:,:,k)   = Starget_ellipse; % target_ellipse with stochastic bounds added to the major and minor axis
    allConstraints.Starget_line(:,:,:,k)      = Starget_line; % line with the stochastic offset
    allConstraints.obstacle_ellipse(:,:,:,k)  = obstacle_ellipse; % ellipse point of the deterministic constraint 
    allConstraints.obstacle_line(:,:,:,k)     = obstacle_line; % line tangential to the ellipse at the closest point of the ellipse to the target
    allConstraints.Sobstacle_ellipse(:,:,:,k) = Sobstacle_ellipse; % target_ellipse with stochastic bounds added to the major and minor axis
    allConstraints.Sobstacle_line(:,:,:,k)    = Sobstacle_line; % line with the stochastic offset
end

end

%% Helper Functions
function [pts, Spts] = buildMaxConstraintPoints(x_max, Pstack, H, N, epsilon, numPoints)
% Return geometry points for max constraint Hx <= xmax
% pts:   [numPoints x 2 x N]
% Spts:  [numPoints x 2 x N]

nc = size(H,1); 
pts  = nan(numPoints, 2, N);
Spts = nan(numPoints, 2, N);

% In 2-D we assume only first two states are constrained for plotting.
% You can adjust if H has a different interpretation.
Z = norminv(1-epsilon);

for k = 1:N
    % covariance at step k
    Pk = Pstack(:,:,k);

    % Bound tightening
    Sigma = H*Pk*H';          % nc x nc
    std_k = sqrt(diag(Sigma));  % nc x 1

    xmax_det = x_max;              % deterministic
    xmax_sto = x_max - Z.*std_k;   % stochastic

    % Produce vertical/horizontal line segment in xy-plane
    % ==============================
    % Deterministic line: H x = xmax_det
    % Stochastic line:    H x = xmax_sto
    % ==============================
    %
    % Assume H selects [x;y] form as:
    %   H = [1 0 ...]
    % or  H = [0 1 ...]
    %
    % For generality: take only the first row of H.

    h = H(1,1:2);   % 1x2
    if abs(h(2)) < 1e-12
        % vertical line: x = xmax(h)
        xval_det = xmax_det(1)/h(1);
        xval_sto = xmax_sto(1)/h(1);

        yvec = linspace(-5,5,numPoints)'; % arbitrary bounds for plotting
        pts(:,1,k)  = xval_det;
        pts(:,2,k)  = yvec;

        Spts(:,1,k) = xval_sto;
        Spts(:,2,k) = yvec;

    else
        % general line: h1*x + h2*y = xmax
        yvec = linspace(-5,5,numPoints)';  
        x_det = (xmax_det(1) - h(2)*yvec)/h(1);
        x_sto = (xmax_sto(1) - h(2)*yvec)/h(1);

        pts(:,1,k)  = x_det;
        pts(:,2,k)  = yvec;

        Spts(:,1,k) = x_sto;
        Spts(:,2,k) = yvec;
    end
end
end


function [ellipsePts, linePts, SellipsePts, SlinePts] = ...
    StochasticHoldingRadiusPoints(rhold, z0, xTstack, PTstack, Offset, N, epsilon, numPoints)

% Outputs:
% ellipsePts   [numPoints x 2 x N]
% linePts      [2 x 2 x N]         % endpoints of tangent line
% SellipsePts  [numPoints x 2 x N]
% SlinePts     [2 x 2 x N]

ellipsePts  = nan(numPoints,2,N);
SellipsePts = nan(numPoints,2,N);
linePts     = nan(2,2,N);
SlinePts    = nan(2,2,N);

H = [eye(2), zeros(2,4)];
Z = norminv(1-epsilon);

% Predict chaser states
n = size(z0,1)/N;
Xc = reshape(z0, n, N);

phi = linspace(0,2*pi,numPoints);
ab  = rhold(:);

for i = 1:N

    %% Target state
    tar = xTstack(:,i);
    pT  = tar(1:2);
    th  = tar(3);
    c = cos(th); s = sin(th);
    R = [c -s; s c];

    % ellipse center in world frame
    C = pT + R*Offset;

    %% Deterministic ellipse
    a = ab(1); b = ab(2);
    e_body = [a*cos(phi); b*sin(phi)];
    e_world = R*e_body + C;        % 2 x numPoints
    ellipsePts(:,:,i) = e_world.'; % numPoints x 2

    %% Tangent point (closest direction to chaser)
    pC = Xc(1:2,i);
    u  = pC - C;
    d  = norm(u);
    if d < 1e-12, u = [1;0]; else, u=u/d; end

    % angle in ellipse frame
    theta_e = atan2(u(2),u(1));
    denom = sqrt((a*sin(theta_e))^2 + (b*cos(theta_e))^2);
    r_e = a*b/denom;

    r0 = C + r_e*u;           % tangent point

    % gradient E for linearization
    S = diag(1./(ab.^2));
    M = R*S*R.';
    E = (r0 - C)'*M;          % 1x2 gradient direction
    g = -2*E.';               % normal vector

    % Tangent line direction
    tDir = [-g(2); g(1)];
    tDir = tDir/norm(tDir);
    L = max(ab)*2;
    linePts(:,:,i) = [r0 - L*tDir,  r0 + L*tDir].';

    %% Stochastic inflation
    Pk = PTstack(:,:,i);
    Sigma = H*Pk*H.';
    sig = sqrt(E*Sigma*E');

    aS = a + Z*sig;   % inflate semi-axes
    bS = b + Z*sig;

    eS_body  = [aS*cos(phi); bS*sin(phi)];
    eS_world = R*eS_body + C;
    SellipsePts(:,:,i) = eS_world.';

    % Stochastic tangent point
    denomS = sqrt((aS*sin(theta_e))^2 + (bS*cos(theta_e))^2);
    rS = aS*bS/denomS;
    r0S = C + rS*u;

    SlinePts(:,:,i) = [r0S - L*tDir,  r0S + L*tDir].';

end
end
